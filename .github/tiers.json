{
  "$comment": "Reusable sizing profiles. Any number of named environment instances (dev1, dev2, uat1, uat2, ...) can reference the same tier in environments.json -- the tier defines sizing, the instance name is just an isolated deployment of that sizing. Keys here map 1:1 to the module arguments in modules/<cloud>/region-stack/variables.tf; scripts/generate-environment.cjs copies a tier's block verbatim into a new environment's generated main.tf.",

  "dev": {
    "description": "Cost-optimized single-AZ/single-NAT sizing for day-to-day development.",
    "requires_approval": false,
    "aws": {
      "availability_zone_suffixes": ["a", "b"],
      "single_nat_gateway": true,
      "kms_deletion_window_days": 7,
      "s3_glacier_transition_days": 30,
      "ecr_immutable_tags": false,
      "ecr_retain_image_count": 10,
      "eks_node_instance_types": ["t3.medium"],
      "eks_desired_size": 2,
      "eks_min_size": 1,
      "eks_max_size": 3,
      "eks_disk_size_gb": 30,
      "eks_private_endpoint": false,
      "rds_instance_class": "db.t3.medium",
      "rds_allocated_storage": 20,
      "rds_multi_az": false,
      "rds_backup_retention_period": 3
    },
    "azure": {
      "subnet_names": ["aks-nodes", "data"],
      "acr_sku": "Basic",
      "keyvault_sku": "standard",
      "keyvault_soft_delete_days": 7,
      "keyvault_purge_protection": false,
      "aks_vm_size": "Standard_D2s_v3",
      "aks_node_count": 2,
      "aks_enable_auto_scaling": false,
      "aks_min_count": 1,
      "aks_max_count": 3
    },
    "gcp": {
      "gke_mode": "standard",
      "gke_node_count": 1,
      "gke_machine_type": "e2-medium",
      "gke_release_channel": "regular",
      "gke_enable_private_cluster": false,
      "cloudsql_tier": "db-f1-micro",
      "cloudsql_high_availability": false,
      "cloudsql_disk_size_gb": 20,
      "kms_protection_level": "SOFTWARE"
    }
  },

